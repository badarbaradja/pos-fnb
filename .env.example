# ─── Supabase ────────────────────────────────────────────────
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# RAHASIA. Hanya untuk server (Server Action, Route Handler, cron).
# Jangan pernah dipakai di Client Component atau diawali NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Settings → Database → Connection string (Session pooler)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ─── Aplikasi ────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Nama POS Kamu"
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Jakarta

# Rahasia untuk endpoint cron (/api/cron/end-of-day)
CRON_SECRET=ganti-dengan-string-acak-panjang

# ─── Integrasi tarikan ke sistem laporan Koperumnas ─────────
# GET /api/integrasi/omzet-harian (lihat CLAUDE.md §3.4, pengecualian tertulis).
# RAHASIA -- produksi: `wrangler secret put INTEGRASI_LAPORAN_TOKEN`. Token yang SAMA
# disimpan di sisi laporan. Minimal 32 karakter acak (mis. `openssl rand -base64 48`);
# lebih pendek dianggap tidak dikonfigurasi (endpoint menjawab 503).
INTEGRASI_LAPORAN_TOKEN=
# Bukan rahasia, tapi WAJIB: UUID bisnis (tabel businesses) yang datanya boleh ditarik.
# Endpoint terikat ke SATU bisnis ini saja.
INTEGRASI_BUSINESS_ID=

# ─── Handoff satu pintu masuk dari reportkoperumnasgroup (25 Sept 2026) ──
# GET /handoff (lihat CLAUDE.md §3.4, pengecualian tertulis). RAHASIA --
# produksi: `wrangler secret put POS_HANDOFF_SECRET`. Nilai SAMA PERSIS
# disimpan di reportkoperumnasgroup (lib/posHandoff.ts, env server-only
# di sana, BUKAN NEXT_PUBLIC_). Cuma menandatangani/memverifikasi token
# pendek (kedaluwarsa 60 detik) yang membawa email -- BUKAN role/outlet.
POS_HANDOFF_SECRET=

# ─── Belum dipakai, isi saat Fase 5 ──────────────────────────
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# SENTRY_DSN=
